# Speech-to-text configuration

# Transcription backend: "openai" or "faster-whisper"
STT_BACKEND=openai

# OpenAI API key (defaults to OPENAI_API_KEY env var)
# STT_OPENAI_API_KEY=sk-...

# Model name (leave empty for backend default)
# OpenAI: whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe
# faster-whisper: tiny.en, base.en, small.en, medium.en, large-v3-turbo
STT_MODEL=

# How to insert text: "clipboard" (just copies, paste manually) or "type" (xdotool keystrokes)
STT_PASTE_METHOD=clipboard
